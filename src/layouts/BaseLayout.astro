---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=980" />
    <meta name="theme-color" content="#1f5a88" />
    <title>{title}</title>
    <link rel="preload" href="/fonts/literata.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-italic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
