---
import SiteLayout from './SiteLayout.astro';
import Band from '../components/Band.astro';
import Part from '../components/Part.astro';
import Cite from '../components/Cite.astro';
import Clip from '../components/Clip.astro';
import More from '../components/More.astro';
import { site } from '../data/site.js';
import { kinds, parts, entries } from '../data/memory.js';
import { capital } from '../lib/text.js';

const path = Astro.url.pathname;
const here = path.endsWith('/') ? path : `${path}/`;
const entry = entries.find((item) => item.link === here);
const { title, about, intro, pairs, steps, practice, references, citation, bibtex, image, video } = entry;

const paragraphs = (text) => [text].flat().filter(Boolean);
const type = (item) => kinds.find((kind) => kind.id === item.kind).heading;

const facts = [
  { label: 'Type', value: type(entry) },
  { label: 'Year', value: entry.year },
];
const others = entries.filter((item) => item !== entry).map((item) => ({ href: item.link, image: item.image, title: item.title, note: type(item) }));
---

<SiteLayout title={`${title} by ${site.name}`} current="/memory/">
  <main>
    <article>
      <Band where={{ label: 'Back to The Art of Training Memory', href: '/memory/' }} title={title} subtitle={capital(about)} facts={facts} />

      <div class="opening">
        <Part id="about" name="About" open>
          {paragraphs(intro).map((text) => <p class="lead" set:html={text} />)}
        </Part>
        <div class="contents">
          <Part name="On this page" side open>
            {
              parts.map((part) => (
                <a href={`#${part.id}`}>
                  {part.heading}
                  <svg viewBox="0 0 16 10" width="13" height="8" aria-hidden="true"><path d="M2 2l6 6 6-6" /></svg>
                </a>
              ))
            }
          </Part>
        </div>
      </div>

      <div class="showing">
        <Part id="example" name="Example" open>
          <div class:list={['frame', { paired: pairs.length > 0 }]}>
            <div class="clip">
              <Clip src={video} poster={image} label={`A clip of ${title}`} />
            </div>
            {
              pairs.length > 0 && (
                <ol class="pairs">
                  {pairs.map(([known, remembered]) => (
                    <li>
                      <span>{known}</span>
                      <svg viewBox="0 0 16 10" width="14" height="9" aria-hidden="true"><path d="M1 5h13M10 1l4 4-4 4" /></svg>
                      <i>{remembered}</i>
                    </li>
                  ))}
                </ol>
              )
            }
          </div>
        </Part>
      </div>

      <div class="columns">
        <div class="main">
          <div class="first">
            <Part id="how" name="How to use" expanded>
              {
                steps.length > 0 && (
                  <ol class="steps">
                    {steps.map((step) => (
                      <li>
                        <p set:html={step} />
                      </li>
                    ))}
                  </ol>
                )
              }
            </Part>
          </div>
          <div class="rest">
            <Part id="practice" name="Practice">
              {paragraphs(practice).map((text) => <p set:html={text} />)}
            </Part>
            <Part id="references" name="References">
              {references.map((reference) => <p class="reference" set:html={reference} />)}
            </Part>
            {
              citation ? (
                <div class="cite" id="cite">
                  <Cite reference={citation} bibtex={bibtex} />
                </div>
              ) : (
                <Part id="cite" name="Cite" />
              )
            }
          </div>
        </div>
        <aside class="side">
          <Part name="More Strategies" side open>
            <More others={others} shape="1920 / 1018" />
          </Part>
        </aside>
      </div>
    </article>
  </main>
</SiteLayout>

<style>
  .opening,
  .showing,
  .columns {
    padding-right: var(--pad);
    padding-left: var(--pad);
  }

  .opening {
    padding-top: 30px;
  }

  .contents {
    display: none;
  }

  .contents a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 46px;
    border-bottom: 1px solid var(--line);
    color: var(--black);
    font-size: 16px;
    line-height: 22px;
  }

  .contents a:hover {
    color: var(--blue);
  }

  svg {
    flex: none;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lead {
    margin-top: 12px;
    color: var(--black);
    font: var(--lead);
  }

  .showing {
    padding-top: 40px;
  }

  .clip {
    margin: 0 calc(var(--pad) * -1);
    border-bottom: 1px solid var(--line);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pairs {
    font-size: 16px;
    line-height: 24px;
    overflow-wrap: anywhere;
    counter-reset: pair;
  }

  .pairs li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) 30px minmax(0, 1fr);
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
    counter-increment: pair;
  }

  .pairs li::before {
    content: counter(pair);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pairs svg {
    stroke-width: 1.8;
  }

  .columns {
    padding-top: 40px;
    padding-bottom: 50px;
  }

  .first {
    border-top: 1px solid var(--ink);
  }

  .side {
    margin-top: 42px;
  }

  .columns p {
    font: var(--text);
  }

  .columns p + p {
    margin-top: 12px;
  }

  .steps {
    counter-reset: step;
  }

  .steps li {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--blue);
    color: var(--white);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
  }

  .steps p {
    min-width: 0;
    margin-top: 2px;
  }

  .columns .reference {
    padding-left: 22px;
    font-size: 16px;
    line-height: 26px;
    text-indent: -22px;
    overflow-wrap: anywhere;
  }

  .columns .reference + .reference {
    margin-top: 10px;
  }

  @media (min-width: 1024px) {
    .opening,
    .columns {
      display: grid;
      grid-template-columns: minmax(0, 79fr) minmax(0, 40fr);
      column-gap: clamp(32px, 4.8%, 60px);
    }

    .opening {
      padding-top: 52px;
    }

    .contents {
      display: block;
    }

    .lead {
      margin-top: 14px;
    }

    .showing {
      padding-top: 56px;
    }

    .frame {
      padding: 32px;
      border: 1px solid var(--line);
      border-top: 0;
    }

    .paired {
      display: grid;
      grid-template-columns: minmax(0, 720fr) minmax(0, 368fr);
      align-items: start;
      column-gap: 48px;
    }

    .clip {
      margin: 0;
      border-bottom: 0;
    }

    .pairs {
      align-self: center;
      border-top: 1px solid var(--line);
    }

    .pairs li {
      grid-template-columns: 32px minmax(0, 1fr) 30px minmax(0, 1fr);
      padding: 3px 0;
    }

    .columns {
      padding-top: 56px;
      padding-bottom: 80px;
    }

    .main,
    .side {
      min-width: 0;
    }

    .first {
      border-top: 0;
    }

    .rest > :global(section) {
      margin-top: 52px;
    }

    .cite {
      margin-top: 48px;
      border-top: 1px solid var(--ink);
    }

    .side {
      margin-top: 0;
    }

    .rest p:first-child,
    .columns p + p {
      margin-top: 14px;
    }

    .steps li {
      gap: 18px;
      padding: 16px 0;
      border-top: 0;
      border-bottom: 1px solid var(--line);
    }

    .steps li::before {
      width: 34px;
      height: 34px;
      font-size: 16px;
    }

    .columns .reference {
      padding-left: 28px;
      text-indent: -28px;
    }
  }
</style>

<script>
  import '../scripts/arrive.js';
</script>
