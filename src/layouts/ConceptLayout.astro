---
import katex from 'katex';
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { site } from '../data/site.js';
import { entries } from '../data/visualizations.js';

const path = Astro.url.pathname;
const here = path.endsWith('/') ? path : `${path}/`;
const { title, intro, explanation, steps, formulas, references, code, citation, bibtex, image, video } = entries.find((entry) => entry.link === here);
const live = Astro.slots.has('default');

const math = (tex: string, displayMode = false) => katex.renderToString(tex, { displayMode, throwOnError: false });
const dollars = new RegExp('[$]([^$]+)[$]', 'g');
const withMath = (text: string) => text.replace(dollars, (all, tex) => math(tex));
const paragraphs = (text: string | string[]) => [text].flat().filter(Boolean);

const parts = [
  ['about', 'About'],
  ['visualization', 'Visualization'],
  ['explanation', 'Explanation'],
  ['how', 'How to use'],
  ['formulas', 'Formulas'],
  ['code', 'Code'],
  ['cite', 'Cite'],
];
---

<BaseLayout title={`${title} by ${site.name}`}>
  <header>
    <PageTitle what="Interactive Visualization" />
    <p class="name">{title}</p>
    <div class="views">
      <div class="show" role="group" aria-label="Show">
        <button type="button" data-show="all" aria-pressed="true" data-text="All">
          <span class="words">All</span>
        </button>
        {parts.map(([id, label]) => (
          <button type="button" data-show={id} aria-pressed="false" data-text={label}>
            <span class="words">{label}</span>
          </button>
        ))}
      </div>
    </div>
  </header>

  <div class="parts" data-parts>
    <section id="about">
      <h2>About</h2>
      {paragraphs(intro).map((text) => (
        <p class="text" set:html={withMath(text)} />
      ))}
    </section>
    <section id="visualization">
      <h2>Visualization</h2>
      {
        (live || video || image) && (
          <div class="stage">
            <slot>
              {video ? (
                <video class="clip" src={video} poster={image} width="640" height="640" muted loop playsinline preload="auto" aria-label={`A clip of the ${title} visualization`} data-clip />
              ) : (
                <img class="clip" src={image} alt={`A picture of the ${title} visualization`} width="640" height="640" />
              )}
            </slot>
          </div>
        )
      }
    </section>
    <section id="explanation">
      <h2>Explanation</h2>
      {paragraphs(explanation).map((text) => (
        <p class="text" set:html={withMath(text)} />
      ))}
    </section>
    <section id="how">
      <h2>How to use</h2>
      {
        steps.length > 0 && (
          <ol class="steps">
            {steps.map((step) => (
              <li set:html={withMath(step)} />
            ))}
          </ol>
        )
      }
    </section>
    <section id="formulas">
      <h2>Formulas</h2>
      {
        formulas.length > 0 && (
          <div class="formulas">
            {formulas.map(({ tex, symbols = [] }, i) => (
              <div class="row">
                <div class="formula">
                  <div class="equation" set:html={math(tex, true)} />
                  <span class="number">({i + 1})</span>
                </div>
                {symbols.length > 0 && (
                  <div class="symbols">
                    {symbols.map(([symbol, meaning]) => (
                      <p>
                        <span class="symbol" set:html={math(symbol)} />
                        <span set:html={withMath(meaning)} />
                      </p>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        )
      }
      {
        references.length > 0 && (
          <div class="references">
            <p class="label">References</p>
            {references.map((reference) => (
              <p class="reference" set:html={withMath(reference)} />
            ))}
          </div>
        )
      }
    </section>
    <section id="code">
      <h2>Code</h2>
      {
        code && (
          <>
            <pre class="code"><code id="code-text">{code}</code></pre>
            <p class="actions">
              <button type="button" data-copy="code-text">
                <span>Copy code</span>
              </button>
            </p>
          </>
        )
      }
    </section>
    <section id="cite">
      <h2>Cite</h2>
      {
        citation && (
          <>
            <p class="text reference" id="citation" set:html={citation} />
            <p class="actions">
              <button type="button" data-copy="citation">
                <span>Copy</span>
              </button>
              {bibtex && (
                <button type="button" aria-expanded="false" aria-controls="bibtex" data-hide="Hide BibTeX">
                  <span>BibTeX</span>
                </button>
              )}
            </p>
            {bibtex && (
              <div id="bibtex" hidden>
                <pre class="code"><code id="bibtex-text">{bibtex}</code></pre>
                <p class="actions">
                  <button type="button" data-copy="bibtex-text">
                    <span>Copy BibTeX</span>
                  </button>
                </p>
              </div>
            )}
          </>
        )
      }
    </section>
  </div>

  <p class="more">See also other <a href="/visualizations/">interactive visualizations</a> by <a href="/">{site.name}</a>.</p>
</BaseLayout>

<style>
  .name {
    margin: 0.5ex 0 0;
    font-size: var(--size-heading);
    font-weight: 700;
    text-align: center;
  }

  .views {
    --band: clamp(12px, calc(1.47cqi - 1px), var(--size-lead));
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.9em;
    padding: 12px;
    border-radius: 8px;
    background-color: var(--c-name);
    box-shadow: inset 0 0 0 5px var(--c-name), inset 0 0 0 calc(5px + var(--line)) rgb(255 205 0 / 0.8);
    color: var(--c-on-brand);
  }

  .show {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-size: var(--band);
  }

  .views button {
    min-height: 44px;
    padding: 0 calc(1em * 7 / 9);
    border: 0;
    border-radius: 3px;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .views button[aria-pressed='false']:hover {
    background-color: rgb(255 255 255 / 0.14);
  }

  .views button[aria-pressed='true'] {
    color: #ffcd00;
    cursor: default;
  }

  .views button[aria-pressed='true'] .words {
    font-weight: 700;
  }

  .views button::after {
    content: attr(data-text);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 700;
  }

  .views button:focus-visible {
    outline: 2px solid var(--c-on-brand);
    outline-offset: 2px;
  }

  .parts {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-top: 36px;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  section[hidden] {
    display: none;
  }

  section p {
    margin: 0;
  }

  h2 {
    margin: 0;
    font-size: var(--size-heading);
    font-style: italic;
    font-weight: 400;
  }

  .text,
  .steps {
    max-width: var(--measure);
  }

  .stage {
    display: flex;
    justify-content: center;
  }

  .clip {
    display: block;
    width: 640px;
    max-width: 100%;
    height: auto;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: flex;
    gap: 14px;
    margin: 0;
    counter-increment: step;
  }

  .steps li::before {
    flex: 0 0 20px;
    color: var(--c-muted);
    text-align: right;
    content: counter(step) '.';
  }

  .formulas {
    display: flex;
    flex-direction: column;
    padding: 4px 22px;
    border: var(--line) solid var(--c-brand);
    background-color: var(--c-mat);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 36px;
    padding: 14px 0;
  }

  .row + .row {
    border-top: 1px solid #d4cebf;
  }

  .formula {
    display: flex;
    flex: 1 1 460px;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .equation {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
  }

  .number {
    flex: none;
    font-family: KaTeX_Main, var(--font);
  }

  .symbols {
    display: flex;
    flex: 1 1 380px;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .symbols p {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .symbol {
    flex: 0 0 120px;
  }

  .formulas :global(.katex) {
    font-size: 1.08em;
  }

  .formulas :global(.katex-display) {
    margin: 0;
  }

  .symbols :global(.katex) {
    font-size: 1em;
  }

  .references {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 4px;
  }

  .label {
    font-weight: 700;
  }

  .reference {
    padding-left: 1.6em;
    text-indent: -1.6em;
    overflow-wrap: anywhere;
  }

  .code {
    margin: 0;
    overflow-x: auto;
    padding: 12px 16px;
    border: var(--line) solid var(--c-brand);
    background-color: var(--c-mat);
    font-family: var(--font-mono);
    font-size: var(--size-small);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14px;
    margin-left: -4px;
  }

  .actions button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-link);
    font: inherit;
    cursor: pointer;
  }

  .actions span {
    padding: 0 4px;
  }

  .actions button:hover span {
    background-color: var(--c-link);
    color: var(--c-bg);
  }

  .actions button:focus-visible {
    outline: 2px solid var(--c-link);
    outline-offset: 2px;
  }

  #bibtex {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #bibtex[hidden] {
    display: none;
  }

  .more {
    margin: 44px 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .views button {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/visualization.js';
  import '../scripts/clips.js';
</script>
