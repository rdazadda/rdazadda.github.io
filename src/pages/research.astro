---
import SiteLayout from '../layouts/SiteLayout.astro';
import Turns from '../components/Turns.astro';
import Project from '../components/Project.astro';
import { site } from '../data/site.js';
import { entries } from '../data/research.js';
---

<SiteLayout title={`Research Projects by ${site.name}`} current="/research/">
  <main>
    <Turns>
      {entries.map((project) => <Project project={project} listed />)}
    </Turns>
  </main>
</SiteLayout>
