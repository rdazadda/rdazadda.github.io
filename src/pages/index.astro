---
import BaseLayout from '../layouts/BaseLayout.astro';
import DayStrip from '../components/DayStrip.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { keepTogether, DOT } from '../lib/text.js';
import { STAGE, CARD, SLOTS, LINKS, home, pileAt, place, pin, fiber } from '../lib/network.js';

// The lines under the name; each logo is public/images/logos/<logo>.svg
const titles = ['Biostatistician', 'Center for Alaska Native Health Research (CANHR)', 'University of Alaska Fairbanks'];
const links = [
  { label: 'Email', href: 'mailto:rdazadda@alaska.edu', logo: 'email' },
  { label: 'Google Scholar', href: '#', logo: 'google-scholar' },
  { label: 'GitHub', href: 'https://github.com/rdazadda', logo: 'github' },
  { label: 'ORCID', href: 'https://orcid.org/0009-0002-4384-4556', logo: 'orcid' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/rdazadda', logo: 'linkedin' },
];

const cards = boxes.map((box, i) => ({
  title: box.title,
  link: box.link,
  slides: box.slides,
  rotates: box.slides.length > 1,
  number: String(i + 1).padStart(2, '0'),
  style: `--home: ${place(home(i), SLOTS[i].tilt)}; --pile: ${place(pileAt(i), SLOTS[i].pile[2])}; z-index: ${boxes.length - i}`,
  input: LINKS.some(([, to]) => to === i),
  output: LINKS.some(([from]) => from === i),
}));

const fibers = LINKS.map(([from, to]) => ({
  d: fiber(pin(from, home(from), 'out'), pin(to, home(to), 'in')),
  layer: SLOTS[from].row + 1,
}));
---

<BaseLayout title={site.name}>
  <h1>{site.name}</h1>

  <p class="titles">{titles.map((title, i) => <>{i > 0 && DOT}{keepTogether(title)}</>)}</p>
  <p class="links">{links.map((link) => <a href={link.href}><img src={`/images/logos/${link.logo}.svg`} alt="" width="20" height="20" /><span>{keepTogether(link.label)}</span></a>)}</p>

  <DayStrip />

  <section class="network" data-network>
    <svg class="fibers" width={STAGE.width} height={STAGE.height} viewBox={`0 0 ${STAGE.width} ${STAGE.height}`} aria-hidden="true">
      {
        fibers.map((item, k) => (
          <g data-link={k} data-layer={item.layer}>
            <path class="line" d={item.d} pathLength="100" />
            <path class="signal outline" d={item.d} pathLength="100" />
            <path class="signal" d={item.d} pathLength="100" />
          </g>
        ))
      }
    </svg>
    {
      cards.map((card, i) => (
        <a class="card" href={card.link} draggable="false" data-card={i} style={card.style}>
          <span class:list={['slides', { rotate: card.rotates }]} data-rotate={card.rotates ? '' : undefined}>
            {card.slides.map((slide, j) => (
              <span class={card.rotates && j === 0 ? 'current' : undefined} inert={j > 0 ? true : undefined}>
                {slide.video ? (
                  <video width={CARD.width - 22} height={CARD.width - 22} src={slide.video} poster={slide.image} muted playsinline preload="auto" loop={!card.rotates} draggable="false" />
                ) : (
                  <img src={slide.image} alt="" width={CARD.width - 22} height={CARD.width - 22} draggable="false" />
                )}
              </span>
            ))}
          </span>
          <span class="number">NO. {card.number}</span>
          <span class="name">{card.title}</span>
          {card.input && <span class="pin in" />}
          {card.output && <span class="pin out" />}
        </a>
      ))
    }
    <button class="put-back" type="button" hidden>Put back</button>
  </section>
  <script is:inline>
    (() => {
      let played = false;
      try {
        played = sessionStorage.getItem('network-opened') === '1';
      } catch {
        played = false;
      }
      if (played || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const network = document.querySelector('[data-network]');
      network.classList.add('opening');
      setTimeout(() => network.classList.remove('opening'), 12000);
    })();
  </script>
</BaseLayout>

<style>
  .titles {
    text-align: center;
  }

  .titles,
  .links {
    margin: 0.3ex 0 0;
    font-size: var(--size-lead);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2ex 1.4em;
  }

  .links img {
    width: 1.1em;
    height: 1.1em;
    margin-right: 0.35em;
    vertical-align: -0.2em;
  }

  .links a:hover {
    text-decoration: none;
  }

  .links a:hover span {
    background-color: var(--c-link);
    color: var(--c-bg);
  }

  .network {
    position: relative;
    width: 940px;
    height: 2030px;
    margin: 0 auto;
  }

  .fibers {
    position: absolute;
    top: 0;
    left: 0;
    overflow: visible;
    pointer-events: none;
  }

  .line {
    fill: none;
    stroke: var(--c-brand);
    stroke-width: calc(var(--line) * 1.75);
    transition:
      stroke-dashoffset 0.5s ease,
      stroke-width 0.2s ease;
  }

  .opening .line,
  .moving .line {
    stroke-dasharray: 100 100;
    stroke-dashoffset: 100;
  }

  .wiring .line {
    stroke-dasharray: 100 100;
    stroke-dashoffset: 0;
  }

  .wiring [data-layer='2'] .line {
    transition-delay: 0.25s, 0s;
  }

  .wiring [data-layer='3'] .line {
    transition-delay: 0.5s, 0s;
  }

  .wiring [data-layer='4'] .line {
    transition-delay: 0.75s, 0s;
  }

  .signal {
    fill: none;
    stroke: var(--c-frame-hover);
    stroke-width: calc(var(--line) * 6);
    stroke-linecap: round;
    stroke-dasharray: 0.1 200;
    stroke-dashoffset: 1;
  }

  .signal.outline {
    stroke: var(--c-brand);
    stroke-width: calc(var(--line) * 9);
  }

  .on .line {
    stroke-width: calc(var(--line) * 3.5);
  }

  .on .signal {
    animation: flow 1.2s linear infinite;
  }

  @keyframes flow {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: -101;
    }
  }

  .card {
    position: absolute;
    top: 0;
    left: 0;
    box-sizing: border-box;
    width: 240px;
    height: 322px;
    padding: 10px 10px 0;
    border: var(--line) solid var(--c-brand);
    background-color: var(--c-card);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.1),
      0 16px 30px -12px rgb(0 0 0 / 0.38);
    transform: var(--home);
    transform-origin: 50% 50%;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .opening .card {
    transform: var(--pile);
  }

  .card:hover,
  .card.active {
    border-color: var(--c-frame-hover);
    box-shadow:
      0 0 0 calc(var(--line) * 2) var(--c-frame-hover),
      0 22px 38px -14px rgb(0 0 0 / 0.42);
    text-decoration: none;
  }

  .card.lift {
    cursor: grabbing;
    box-shadow:
      0 0 0 calc(var(--line) * 2) var(--c-frame-hover),
      0 34px 54px -20px rgb(0 0 0 / 0.5);
  }

  .card:focus-visible {
    outline: 2px solid var(--c-link);
    outline-offset: 4px;
  }

  .slides {
    display: grid;
  }

  .slides > * {
    grid-area: 1 / 1;
  }

  .rotate > * {
    transition: opacity 0.9s ease-in-out;
  }

  .rotate > :not(.current) {
    opacity: 0;
  }

  .slides img,
  .slides video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .number {
    display: block;
    margin-top: 12px;
    color: var(--c-brand);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    line-height: 13px;
  }

  .name {
    display: block;
    margin-top: 6px;
    color: var(--c-link);
    font-size: var(--size-heading);
    font-weight: 700;
    line-height: 24px;
  }

  .pin {
    position: absolute;
    left: 50%;
    width: calc(12px + var(--line) * 2);
    height: calc(12px + var(--line) * 2);
    border-radius: 50%;
    background-color: var(--c-bg);
    box-shadow: 0 0 0 calc(var(--line) * 2) var(--c-brand);
    transform: translate(-50%, -50%);
    transition: background-color 0.25s ease;
  }

  .pin.in {
    top: calc(var(--line) * -1);
  }

  .pin.out {
    top: calc(100% + var(--line));
  }

  .lit .pin {
    background-color: var(--c-frame-hover);
  }

  .put-back {
    position: absolute;
    top: 40px;
    right: 0;
    margin: 0;
    padding: 6px 10px;
    border: 0;
    background: none;
    color: var(--c-link);
    font: inherit;
    font-size: var(--size-lead);
    cursor: pointer;
  }

  .put-back:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .put-back:focus-visible {
    outline: 2px solid var(--c-link);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .signal {
      animation: none !important;
    }

    .card,
    .line,
    .pin,
    .rotate > * {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/network.js';
  import '../scripts/rotate.js';
</script>
