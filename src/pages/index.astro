---
import SiteLayout from '../layouts/SiteLayout.astro';
import Welcome from '../components/Welcome.astro';
import Box from '../components/Box.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
---

<SiteLayout title={site.name}>
  <main>
    <Welcome />

    <section>
      <h2>Explore</h2>
      <ul class="grid">
        {
          boxes.map((box) => (
            <li>
              <Box title={box.title} link={box.link} slides={box.slides} />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</SiteLayout>

<style>
  main {
    padding: 24px var(--pad) 60px;
    background: var(--band);
  }

  h2 {
    margin: 40px 0 20px;
    color: var(--black);
    font: var(--heading);
    text-align: center;
  }

  .grid {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 30px;
  }

  li {
    display: flex;
  }

  @media (min-width: 530px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    main {
      padding-top: 40px;
      padding-bottom: 90px;
    }

    h2 {
      margin-top: 56px;
    }

    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
