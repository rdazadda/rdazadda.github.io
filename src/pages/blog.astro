---
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/Band.astro';
import Part from '../components/Part.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { posts } from '../lib/posts.js';

const FIRST = 4;
const box = boxes.find((item) => item.link === '/blog/');
const years = [...new Set(posts.map((post) => post.year))];
const topics = [...new Set(posts.map((post) => post.topic).filter(Boolean))]
  .map((name) => ({ name, count: posts.filter((post) => post.topic === name).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<SiteLayout title={`${box.title} by ${site.name}`} current="/blog/">
  <main>
    <Band title={box.title} facts={[]} />

    <div class="columns">
      <div class="main">
        <Part name="Most Recent" open>
          <div data-posts>
            {
              posts.map((post, i) => {
                const { shown, more } = post.open(i === 0 ? 2 : 1);
                return (
                  <article class:list={{ lead: i === 0 }} hidden={i >= FIRST}>
                    <p class="when">
                      {post.day}
                      {post.topic && <> &bull; {post.topic}</>}
                    </p>
                    <h3>
                      <a href={post.link}>{post.title}</a>
                    </h3>
                    {post.picture && (
                      <a class="picture" href={post.link} aria-hidden="true" tabindex="-1">
                        <img src={post.picture} alt="" width="790" height="444" loading={i > 0 ? 'lazy' : undefined} />
                      </a>
                    )}
                    {shown.map((text) => <p class="text" set:html={text} />)}
                    {more && (
                      <a class="read" href={post.link}>
                        <span>Read the post</span>
                        <svg viewBox="0 0 10 16" width="8" height="13" aria-hidden="true"><path d="M2 2l6 6-6 6" /></svg>
                      </a>
                    )}
                  </article>
                );
              })
            }
          </div>
          {
            posts.length > FIRST && (
              <button type="button" class="older" data-older>
                Older Posts
                <svg viewBox="0 0 16 10" width="13" height="8" aria-hidden="true"><path d="M2 2l6 6 6-6" /></svg>
              </button>
            )
          }
        </Part>
      </div>

      <aside class="side">
        <Part name="All Posts" side open>
          <div class="list" data-list>
            {
              years.map((year) => (
                <div>
                  <p class="year">{year}</p>
                  {posts
                    .filter((post) => post.year === year)
                    .map((post) => (
                      <a href={post.link} data-topic={post.topic}>
                        <span class="title">{post.title}</span>
                        <span class="date">{post.short}</span>
                      </a>
                    ))}
                </div>
              ))
            }
          </div>
        </Part>
        <div class="topics">
          <Part name="Topics" side open>
            <div role="group" aria-label="Topics" data-topics>
              {
                topics.map((topic) => (
                  <button type="button" aria-pressed="false" data-topic={topic.name}>
                    <span>{topic.name}</span>
                    <span class="count">{topic.count}</span>
                  </button>
                ))
              }
            </div>
          </Part>
        </div>
      </aside>
    </div>
  </main>
</SiteLayout>

<style>
  .columns {
    padding: 30px var(--pad) 46px;
    overflow-wrap: anywhere;
  }

  .main,
  .side {
    min-width: 0;
  }

  article {
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .when {
    color: var(--black);
    font-size: 15px;
    line-height: 22px;
  }

  h3 {
    margin: 3px 0 0;
    color: var(--black);
    font: var(--heading);
  }

  h3 a {
    display: block;
    padding: 7px 0;
  }

  .lead h3 {
    font: var(--featured);
  }

  .lead h3 a {
    padding: 5px 0;
  }

  h3 a:hover,
  .read:hover {
    color: var(--blue);
  }

  .picture {
    display: block;
    margin: 4px calc(var(--pad) * -1) 0;
  }

  .picture img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .text {
    margin-top: 5px;
    font: var(--text);
  }

  .lead .text {
    margin-top: 7px;
  }

  article .text + .text {
    margin-top: 12px;
  }

  article .picture + .text {
    margin-top: 16px;
  }

  .read {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    margin-top: 6px;
    color: var(--black);
    font-size: 16px;
    font-weight: 700;
    line-height: 22px;
  }

  .read span {
    border-bottom: 2px solid var(--blue);
  }

  svg {
    flex: none;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .older {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 60px;
    margin-top: -1px;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--black);
    font: var(--side);
    text-align: left;
    cursor: pointer;
  }

  .older:hover {
    color: var(--blue);
  }

  .older[hidden],
  .list [hidden] {
    display: none;
  }

  .side {
    margin-top: 40px;
  }

  .list {
    position: relative;
    padding-right: 10px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) var(--band);
  }

  .year {
    position: sticky;
    top: 0;
    padding: 14px 0 6px;
    border-bottom: 1px solid var(--line);
    background: var(--white);
    color: var(--black);
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
  }

  .list a {
    display: block;
    padding: 11px 0 12px;
    border-bottom: 1px solid var(--line);
  }

  .title,
  .date {
    display: block;
  }

  .title {
    color: var(--black);
    font-size: 16px;
    font-weight: 700;
    line-height: 21px;
  }

  .date {
    margin-top: 2px;
    font-size: 14px;
    line-height: 22px;
  }

  .list a:hover .title {
    color: var(--blue);
  }

  .topics {
    margin-top: 36px;
  }

  .topics button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    min-height: 46px;
    padding: 6px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--black);
    font: inherit;
    font-size: 16px;
    line-height: 22px;
    text-align: left;
    cursor: pointer;
  }

  .topics button:hover {
    color: var(--blue);
  }

  .topics [aria-pressed='true'] span:first-child {
    border-bottom: 2px solid var(--blue);
    font-weight: 700;
  }

  .count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 1024px) {
    .columns {
      display: grid;
      grid-template-columns: minmax(0, 79fr) minmax(0, 40fr);
      column-gap: clamp(32px, 4.8%, 60px);
      padding-top: 52px;
      padding-bottom: 80px;
    }

    article {
      padding: 28px 0 30px;
    }

    h3 a {
      padding: 5px 0;
    }

    .picture {
      margin: 13px 0 0;
    }

    .text {
      margin-top: 9px;
    }

    .lead .text {
      margin-top: 11px;
    }

    article .text + .text {
      margin-top: 14px;
    }

    article .picture + .text {
      margin-top: 18px;
    }

    .read {
      margin-top: 8px;
    }

    .side {
      margin-top: 0;
    }

    .list {
      padding-right: 12px;
    }

    .topics {
      margin-top: 30px;
    }
  }
</style>

<script>
  import '../scripts/blog.js';
</script>
