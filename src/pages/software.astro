---
import SiteLayout from '../layouts/SiteLayout.astro';
import Turns from '../components/Turns.astro';
import Software from '../components/Software.astro';
import { site } from '../data/site.js';
import { entries } from '../data/software.js';
---

<SiteLayout title={`Software by ${site.name}`} current="/software/">
  <main>
    <Turns>
      {entries.map((software) => <Software software={software} listed />)}
    </Turns>
  </main>
</SiteLayout>
