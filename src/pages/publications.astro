---
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/Band.astro';
import Publications from '../components/Publications.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { kinds, entries } from '../data/publications.js';

const box = boxes.find((item) => item.link === '/publications/');
const count = (kind) => entries.filter((entry) => entry.kind === kind.id).length;
const facts = kinds.filter((kind) => count(kind) > 0).map((kind) => ({ label: kind.heading, value: String(count(kind)) }));
---

<SiteLayout title={`${box.title} by ${site.name}`} current="/publications/">
  <main>
    <Band title={box.title} subtitle={box.caption} facts={facts} />
    <Publications />
  </main>
</SiteLayout>
