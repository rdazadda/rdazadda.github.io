---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { sections } from '../data/about.js';

const box = boxes.find((item) => item.link === '/about/');
const paragraphs = (text) => [text].flat().filter(Boolean);
---

<SiteLayout title={`${box.title} ${site.name}`} current="/about/">
  <main>
    <header>
      <div class="title">
        <h1>{box.title}</h1>
        <p class="caption" set:html={box.caption} />
        <button class="all" type="button" aria-pressed="true" data-show="all"><span class="words">All</span></button>
      </div>
      <div class="windows">
        {
          sections.map((section) => {
            const rotates = section.slides.length > 1;
            return (
              <button class="window" type="button" aria-pressed="false" data-show={section.id}>
                <span class:list={['slides', { rotate: rotates }]} data-rotate={rotates ? '' : undefined}>
                  {section.slides.map((slide, i) => (
                    <picture class={rotates && i === 0 ? 'current' : undefined}>
                      {slide.phone && <source media="(min-width: 640px)" srcset={slide.image} />}
                      <img src={slide.phone ?? slide.image} alt="" style={slide.fill && `object-position: ${slide.fill}`} />
                    </picture>
                  ))}
                </span>
                <span class="name"><span class="words">{section.heading}</span></span>
              </button>
            );
          })
        }
      </div>
    </header>

    <div class="parts" data-parts>
      <div class="rows">
        {
          sections.map((section) => (
            <section id={section.id}>
              <h2>{section.heading}</h2>
              <div class="text">
                {paragraphs(section.text).map((paragraph) => <p set:html={paragraph} />)}
                {section.interests && (
                  <dl>
                    <div>
                      <dt>Research interests</dt>
                      <dd>{section.interests}</dd>
                    </div>
                  </dl>
                )}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  header {
    container-type: inline-size;
    padding-top: 22px;
    background: var(--stage);
    color: var(--white);
  }

  .title {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    padding: 0 var(--pad);
  }

  h1 {
    grid-area: 1 / 1;
    font: var(--title);
    letter-spacing: -0.02em;
  }

  .caption {
    grid-area: 2 / 1 / 3 / 3;
    margin-top: 8px;
    font: var(--text);
  }

  .all {
    grid-area: 1 / 2;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 44px;
    height: 44px;
    margin: -2px 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 22px;
    cursor: pointer;
  }

  .all:focus-visible {
    outline-color: var(--gold);
  }

  .words {
    padding: 3px 0;
    border-bottom: 3px solid transparent;
  }

  [aria-pressed='true'] .words {
    border-color: var(--gold);
  }

  .windows {
    --slant: 15.4cqw;
    display: flex;
    flex-direction: column;
    margin-top: 4px;
    padding-top: 3px;
    background: var(--gold);
    clip-path: polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);
  }

  .window {
    position: relative;
    height: 54cqw;
    padding: 0;
    border: 0;
    background: var(--black);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    clip-path: polygon(0 var(--slant), 100% 0, 100% calc(100% - var(--slant)), 0 100%);
  }

  .window + .window {
    margin-top: calc(3px - var(--slant));
  }

  .window:last-child {
    clip-path: polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);
  }

  .window:focus-visible {
    outline: 0;
  }

  .slides {
    position: absolute;
    inset: 0;
    transition: opacity 0.3s ease;
  }

  .windows:has([aria-pressed='true']) [aria-pressed='false'] .slides {
    opacity: 0.35;
  }

  picture {
    position: absolute;
    inset: 0;
  }

  .rotate picture {
    transition: opacity 0.9s ease-in-out;
  }

  .rotate picture:not(.current) {
    opacity: 0;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    position: absolute;
    bottom: 34px;
    left: var(--pad);
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    background: var(--black);
    font: var(--side);
  }

  .window:last-child .name {
    bottom: 16px;
  }

  .window:focus-visible .name {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .all:hover,
  .window:hover .name {
    color: var(--gold);
  }

  .parts {
    padding: 24px var(--pad) 40px;
  }

  .rows {
    border-bottom: 1px solid var(--ink);
  }

  section {
    padding: 18px 0 26px;
    border-top: 1px solid var(--ink);
    color: var(--black);
  }

  h2 {
    font: var(--heading);
  }

  .text {
    font: var(--text);
  }

  .text > * {
    margin-top: 14px;
  }

  .text > dl {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }

  dl div {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: 15px;
    font-weight: 700;
    line-height: 22px;
  }

  dd {
    margin-top: 2px;
  }

  @media (min-width: 640px) {
    header {
      padding-bottom: 30px;
    }

    .windows {
      --slant: 43px;
      flex-direction: row;
      height: 300px;
      margin: 18px var(--pad) 0;
      padding: 0 4px;
    }

    .windows,
    .window,
    .window:last-child {
      clip-path: polygon(var(--slant) 0, 100% 0, calc(100% - var(--slant)) 100%, 0 100%);
    }

    .window {
      flex: none;
      width: calc((100% - 8px + 2 * var(--slant)) / 3);
      height: auto;
    }

    .window + .window {
      margin: 0 0 0 calc(4px - var(--slant));
    }

    .name {
      right: 0;
      left: 0;
      height: 46px;
      padding: 0 0 0 22px;
    }

    .name,
    .window:last-child .name {
      bottom: 0;
    }

    .window:focus-visible .name {
      outline: 0;
    }

    .window:focus-visible .words {
      outline: 2px solid var(--gold);
      outline-offset: 5px;
    }
  }

  @media (min-width: 1024px) {
    header {
      padding-top: 30px;
      padding-bottom: 40px;
    }

    .caption {
      grid-area: 2 / 1;
      max-width: 820px;
    }

    .all {
      grid-area: 1 / 2 / 3 / 3;
      align-self: end;
      margin: 0;
    }

    .windows {
      --slant: 50px;
      height: 340px;
      margin-top: 22px;
    }

    .name {
      height: 50px;
      padding-left: 26px;
    }

    .parts {
      padding-top: 44px;
      padding-bottom: 68px;
    }

    section {
      display: flex;
      gap: 40px;
      padding: 26px 0 38px;
    }

    section[hidden] {
      display: none;
    }

    h2 {
      flex: 0 0 250px;
    }

    .text {
      flex: 1;
      min-width: 0;
      max-width: 700px;
      padding-top: 1px;
    }

    .text > * {
      margin-top: 16px;
    }

    .text > dl {
      margin-top: 28px;
    }

    .text > :first-child {
      margin-top: 0;
    }

    dl div {
      display: flex;
      gap: 24px;
      padding: 14px 0;
    }

    dt {
      flex: 0 0 170px;
      font-size: 16px;
      line-height: 28px;
    }

    dd {
      flex: 1;
      min-width: 0;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slides,
    .rotate picture {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/about.js';
</script>
