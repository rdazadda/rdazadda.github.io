---
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/Band.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { pictures, sections } from '../data/about.js';

const box = boxes.find((item) => item.link === '/about/');
const paragraphs = (text) => [text].flat().filter(Boolean);
---

<SiteLayout title={`${box.title} ${site.name}`} current="/about/">
  <main>
    <Band title={box.title} subtitle={box.caption} facts={[]} />
    <div class="about">
      <figure data-album>
        <div class="frame">
          {pictures.map((picture, i) => <img class={i === 0 ? 'current' : undefined} src={picture} alt="" width="900" height="900" />)}
        </div>
        <figcaption>
          <span class="count" data-count>1 / {pictures.length}</span>
          <button type="button" aria-label="Previous picture" data-step="-1">
            <svg viewBox="0 0 10 16" width="9" height="15" aria-hidden="true"><path d="M8 2 2 8l6 6" /></svg>
          </button>
          <button type="button" aria-label="Next picture" data-step="1">
            <svg viewBox="0 0 10 16" width="9" height="15" aria-hidden="true"><path d="M2 2l6 6-6 6" /></svg>
          </button>
        </figcaption>
      </figure>
      <div class="rows">
        {
          sections.map((section) => {
            const text = paragraphs(section.text);
            return (
              <section id={section.id}>
                <h2>{section.heading}</h2>
                {(text.length > 0 || section.interests) && (
                  <div class="text">
                    {text.map((paragraph) => (
                      <p set:html={paragraph} />
                    ))}
                    {section.interests && (
                      <dl>
                        <div>
                          <dt>Research interests</dt>
                          <dd>{section.interests}</dd>
                        </div>
                      </dl>
                    )}
                  </div>
                )}
              </section>
            );
          })
        }
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  .about {
    padding: 24px var(--pad) 40px;
    color: var(--black);
  }

  figure {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--band);
  }

  .frame img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    visibility: hidden;
    transition: visibility 0s 0.8s;
  }

  .frame .current {
    z-index: 1;
    visibility: visible;
    transition: none;
  }

  .frame .arriving {
    animation: arrive 0.8s ease-in-out;
  }

  @keyframes arrive {
    from {
      opacity: 0;
    }
  }

  figcaption {
    display: flex;
    align-items: center;
    height: 52px;
  }

  .count {
    flex: 1;
    font-size: 15px;
    line-height: 22px;
    font-variant-numeric: tabular-nums;
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  button:last-child {
    margin-right: -14px;
  }

  button:hover {
    color: var(--blue);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rows {
    margin-top: 8px;
  }

  section {
    padding: 20px 0 26px;
    border-top: 1px solid var(--line);
  }

  section:first-child {
    border-color: var(--ink);
  }

  section:last-child {
    padding-bottom: 0;
  }

  h2 {
    font: var(--heading);
  }

  .text {
    margin-top: 10px;
    font: var(--text);
  }

  .text > * + * {
    margin-top: 10px;
  }

  .text > dl {
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }

  dl div {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: 15px;
    font-weight: 700;
    line-height: 22px;
  }

  dd {
    margin-top: 2px;
  }

  @media (min-width: 640px) {
    .about {
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(42%, 500px);
      align-items: start;
      column-gap: 32px;
      padding-top: 32px;
      padding-bottom: 56px;
    }

    figure {
      position: sticky;
      top: 114px;
      grid-area: 1 / 2;
    }

    figcaption {
      border-bottom: 1px solid var(--line);
    }

    .rows {
      grid-area: 1 / 1;
      margin-top: 0;
    }
  }

  @media (min-width: 1024px) {
    .about {
      column-gap: 64px;
      padding-top: 56px;
      padding-bottom: 80px;
    }

    figure {
      top: 137px;
    }

    figcaption {
      height: 56px;
    }

    section {
      padding: 26px 0 34px;
    }

    .text {
      margin-top: 14px;
    }

    .text > * + * {
      margin-top: 12px;
    }

    .text > dl {
      margin-top: 20px;
    }

    dl div {
      display: flex;
      gap: 24px;
      padding: 14px 0;
    }

    dt {
      flex: 0 0 170px;
      font-size: 16px;
      line-height: 28px;
    }

    dd {
      flex: 1;
      min-width: 0;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame img {
      transition: none;
    }

    .frame .arriving {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/about.js';
</script>
