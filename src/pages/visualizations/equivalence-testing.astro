---
import VisualizationLayout from '../../layouts/VisualizationLayout.astro';
import EquivalenceViz from '../../components/EquivalenceViz.astro';
import Report from '../../components/Report.astro';
import { START, report } from '../../lib/equivalence.js';

const lead = 'A good equivalence plan explains how the bounds were chosen, names the test and its error rates, and gives the sample size with dropout (Lakens et al., 2018). The example below follows the plan above and changes with it. Replace the parts in brackets before using it.';
---

<VisualizationLayout>
  <EquivalenceViz />
  <Report slot="report" lead={lead} text={report(START)} />
</VisualizationLayout>
