---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { kinds, parts, entries } from '../data/memory.js';
import { capital } from '../lib/text.js';

const box = boxes.find((item) => item.link === '/memory/');
const type = (entry) => kinds.find((kind) => kind.id === entry.kind).heading;
---

<SiteLayout title={`${box.title} by ${site.name}`} current="/memory/">
  <main>
    <header>
      <h1>{box.title}</h1>
      <p class="caption" set:html={box.caption} />

      <div class="stage" data-stage>
        {
          entries.map((entry, i) => (
            <article class:list={{ current: i === 0 }} inert={i > 0}>
              <a class="clip" href={entry.link} aria-hidden="true" tabindex="-1">
                <video src={entry.video} poster={entry.image} width="790" height="419" muted playsinline preload="none" />
                <span class="played" />
              </a>
              <div class="text">
                <p class="type">
                  <span>{type(entry)}</span>
                  <span>
                    {i + 1} / {entries.length}
                  </span>
                </p>
                <h2>{entry.title}</h2>
                {entry.about && <p class="lead" set:html={capital(entry.about)} />}
                <a class="open" href={entry.link}>
                  <span>Learn the strategy</span>
                  <svg viewBox="0 0 10 16" width="8" height="13" aria-hidden="true"><path d="M2 2l6 6-6 6" /></svg>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div class="tabs" data-tabs>
        {
          entries.map((entry, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="number">{i + 1}</span>
              <span>{entry.title}</span>
            </button>
          ))
        }
      </div>
    </header>

    <div class="parts" data-parts>
      {
        entries.map((entry, i) => (
          <div class:list={['row', { current: i === 0 }]}>
            <p class="name">{entry.title}</p>
            <nav aria-label={entry.title}>
              {parts.map((part) => (
                <a href={`${entry.link}#${part.id}`}>
                  {part.heading}
                  <svg viewBox="0 0 10 16" width="7" height="11" aria-hidden="true"><path d="M2 2l6 6-6 6" /></svg>
                </a>
              ))}
            </nav>
          </div>
        ))
      }
    </div>
  </main>
</SiteLayout>

<style>
  header {
    padding-top: 26px;
    background: var(--stage);
    color: var(--white);
  }

  header a:focus-visible,
  header button:focus-visible {
    outline-color: var(--gold);
  }

  h1,
  .caption {
    padding: 0 var(--pad);
  }

  h1 {
    font: var(--title);
    letter-spacing: -0.02em;
  }

  .caption {
    margin-top: 8px;
    font: var(--text);
  }

  .stage {
    display: grid;
    margin-top: 22px;
  }

  article {
    grid-area: 1 / 1;
    min-width: 0;
  }

  article:not(.current) .text {
    visibility: hidden;
  }

  .clip {
    display: block;
    background: var(--white);
    transition: opacity 0.5s ease-in-out;
  }

  article:not(.current) .clip {
    opacity: 0;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 1018;
  }

  .played {
    display: block;
    height: 4px;
    background: var(--rule);
  }

  .played::after {
    display: block;
    height: 100%;
    background: var(--gold);
    transform: scaleX(var(--played, 0));
    transform-origin: left;
    content: '';
  }

  .text {
    padding: 18px var(--pad) 0;
  }

  .type {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    line-height: 22px;
    font-variant-numeric: tabular-nums;
  }

  h2 {
    margin-top: 16px;
    font: var(--featured);
  }

  .lead {
    margin-top: 8px;
    font: var(--lead);
  }

  .open {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 4px;
    font-size: 16px;
    font-weight: 700;
  }

  .open span {
    border-bottom: 2px solid var(--gold);
  }

  svg {
    flex: none;
    fill: none;
    stroke: var(--gold);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tabs {
    display: grid;
    margin: 16px var(--pad) 0;
  }

  .tabs button {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 0;
    border: 0;
    border-top: 1px solid var(--rule);
    background: none;
    color: inherit;
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 22px;
    text-align: left;
    cursor: pointer;
  }

  .number {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 32px;
    height: 32px;
    border: 2px solid var(--white);
    border-radius: 50%;
    font-size: 15px;
    line-height: 1;
  }

  [aria-pressed='true'] .number {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--black);
  }

  .open:hover,
  .tabs button:hover {
    color: var(--gold);
  }

  .parts {
    padding: 24px var(--pad) 48px;
    color: var(--black);
  }

  .row:not(.current) {
    display: none;
  }

  .name {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
    font: var(--heading);
  }

  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
    font-size: 15px;
    font-weight: 600;
    line-height: 22px;
  }

  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    min-height: 46px;
    border-bottom: 1px solid var(--line);
  }

  nav a:hover {
    color: var(--blue);
  }

  nav svg {
    stroke: var(--blue);
    stroke-width: 2.4;
  }

  @media (min-width: 1024px) {
    header {
      padding-top: 40px;
    }

    .caption {
      max-width: 820px;
    }

    .stage {
      margin: 34px var(--pad) 0;
    }

    article {
      display: grid;
      grid-template-columns: minmax(0, 79fr) minmax(0, 40.8fr);
      align-items: center;
      gap: clamp(32px, 4.16%, 52px);
    }

    .text {
      padding: 0;
    }

    .type {
      padding-bottom: 12px;
    }

    h2 {
      margin-top: 22px;
    }

    .lead {
      margin-top: 12px;
    }

    .open {
      margin-top: 10px;
    }

    .tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 36px;
      border-top: 1px solid var(--rule);
    }

    .tabs button {
      box-sizing: border-box;
      min-height: 78px;
      padding-right: 16px;
      border-top: 3px solid transparent;
      border-bottom: 3px solid transparent;
    }

    .tabs [aria-pressed='true'] {
      border-bottom-color: var(--gold);
    }

    .number {
      width: 34px;
      height: 34px;
      font-size: 16px;
    }

    .parts {
      padding-top: 0;
      padding-bottom: 88px;
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0 40px;
      min-height: 76px;
      border-bottom: 1px solid var(--ink);
    }

    .name {
      padding: 0;
      border: 0;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0 34px;
      font-size: 16px;
    }

    nav a {
      min-height: 44px;
      border: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .clip {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/memory.js';
</script>
