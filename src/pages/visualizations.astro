---
import SiteLayout from '../layouts/SiteLayout.astro';
import Band from '../components/Band.astro';
import Viewer from '../components/Viewer.astro';
import { site } from '../data/site.js';
import { boxes } from '../data/boxes.js';
import { kinds, entries } from '../data/visualizations.js';

const box = boxes.find((item) => item.link === '/visualizations/');
const facts = kinds.map((kind) => ({ label: kind.heading, value: String(entries.filter((entry) => entry.kind === kind.id).length) }));
---

<SiteLayout title={`${box.title} by ${site.name}`} current="/visualizations/">
  <main>
    <Band title={box.title} subtitle={box.caption} facts={facts} />
    <Viewer />
  </main>
</SiteLayout>
