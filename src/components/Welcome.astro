---
import { site } from '../data/site.js';
---

<div class="welcome">
  <div class="side">
    <img src="/images/home/welcome.webp" alt="" width="1074" height="904" />
    <div class="now">
      <p class="place">Fairbanks, Alaska</p>
      <div class="row">
        <p class="number"><span data-now="time">&nbsp;</span> <span class="unit" data-now="period"></span></p>
        <p class="note" data-now="date">&nbsp;</p>
      </div>
      <div class="row waiting" data-now="weather">
        <p class="number degrees">
          <span><span data-now="fahrenheit"></span> <span class="unit">°F</span></span>
          <span><span data-now="celsius"></span> <span class="unit">°C</span></span>
        </p>
        <p class="note" data-now="sky">&nbsp;</p>
      </div>
    </div>
  </div>
  <div class="words">
    <h1>{site.greeting}</h1>
    <div class="text">
      {site.welcome.map((paragraph) => <p set:html={paragraph} />)}
    </div>
  </div>
</div>

<style>
  .welcome {
    background: var(--white);
    overflow-wrap: anywhere;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 358 / 250;
    object-fit: cover;
    background: var(--band);
  }

  .now {
    margin: 14px 20px 0;
  }

  .place {
    padding-bottom: 9px;
    border-bottom: 1px solid var(--ink);
    color: var(--black);
    font-size: 15px;
    font-weight: 700;
    line-height: 22px;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 0 12px;
    border-bottom: 1px solid var(--line);
  }

  .row[hidden] {
    display: none;
  }

  .waiting {
    visibility: hidden;
  }

  .number {
    flex: none;
    color: var(--black);
    font-size: 24px;
    font-weight: 700;
    line-height: 32px;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    font-size: 15px;
    letter-spacing: 0;
  }

  .degrees {
    display: flex;
    align-items: baseline;
  }

  .degrees > span + span {
    margin-left: 14px;
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }

  .note {
    font-size: 14px;
    line-height: 20px;
    text-align: right;
  }

  .words {
    padding: 24px 20px 26px;
  }

  h1 {
    color: var(--black);
    font: var(--title);
    letter-spacing: -0.02em;
  }

  .text {
    margin-top: 14px;
    font: var(--text);
    text-wrap: pretty;
  }

  .text p + p {
    margin-top: 12px;
  }

  .text :global(a) {
    border-bottom: 2px solid var(--blue);
    color: var(--black);
  }

  .text :global(a:hover) {
    color: var(--blue);
  }

  @media (min-width: 640px) {
    .side {
      display: grid;
      grid-template-columns: min(42%, 340px) minmax(0, 1fr);
      align-items: center;
    }

    img {
      aspect-ratio: 400 / 264;
    }

    .now {
      max-width: 420px;
      margin: 0 28px;
    }

    .words {
      padding: 24px 28px 30px;
    }
  }

  @media (min-width: 1024px) {
    .welcome {
      display: flex;
    }

    .side {
      display: flex;
      flex: 0 0 clamp(350px, 32%, 400px);
      flex-direction: column;
      align-items: stretch;
    }

    img {
      flex: 1 0 auto;
    }

    .now {
      max-width: none;
      margin: 14px 24px 6px;
    }

    .row:last-child {
      border-bottom: 0;
    }

    .words {
      flex: 1;
      min-width: 0;
      align-self: center;
      padding: 40px;
    }

    .text {
      margin-top: 16px;
    }

    .text p + p {
      margin-top: 14px;
    }
  }

  @media (min-width: 1280px) {
    .words {
      padding: 40px 48px;
    }
  }
</style>

<script>
  import '../scripts/welcome.js';
</script>
