---
import Copy from './Copy.astro';
import { keepTogether } from '../lib/text.js';
import { bibtexEntry } from '../lib/bibtex.js';
import { me, kinds } from '../data/publications.js';

interface Link {
  label: string;
  href: string;
}

interface Props {
  id: string;
  first: boolean;
  kind: string;
  year: string;
  title: string;
  authors: string[];
  venue: string;
  image?: string;
  links?: Link[];
  reference?: string;
  bibtex?: Record<string, string>;
}

const { id, first, kind, year, title, authors, venue, image, links = [], reference, bibtex } = Astro.props;

const type = kinds.find((item) => item.id === kind);
const between = (i: number) => (i === 0 ? '' : i === authors.length - 1 ? ', &\u00a0' : ', ');
const titleEnd = /[.?!]$/.test(title) ? '' : '.';
const authorsEnd = authors.at(-1).endsWith('.') ? '' : '.';
const bib = bibtex && bibtexEntry(type.bibtex, { title, authors, year, fields: bibtex });
---

<article class:list={{ current: first }} inert={!first} data-type={type.heading}>
  <div class="picture">{image && <img src={image} alt="" width="640" height="480" loading={first ? undefined : 'lazy'} />}</div>
  <div class="text">
    <h2>{title}</h2>
    <p class="authors">{authors.map((name, i) => <>{between(i)}{name === me ? <strong>{keepTogether(name)}</strong> : keepTogether(name)}</>)}</p>
    <p class="venue" set:html={venue} />
    {
      (links.length > 0 || reference || bib) && (
        <div class="actions">
          {links.length > 0 && (
            <p>
              {links.map((item) => (
                <a href={item.href}>
                  <span>{item.label}</span>
                  <svg viewBox="0 0 10 16" width="8" height="13" aria-hidden="true"><path d="M2 2l6 6-6 6" /></svg>
                </a>
              ))}
            </p>
          )}
          {(reference || bib) && (
            <p>
              {reference && (
                <button type="button" aria-expanded="false" aria-controls={`${id}-reference`}>
                  Cite
                  <svg viewBox="0 0 16 10" width="13" height="8" aria-hidden="true"><path d="M2 2l6 6 6-6" /></svg>
                </button>
              )}
              {bib && (
                <button type="button" aria-expanded="false" aria-controls={`${id}-bibtex`}>
                  BibTeX
                  <svg viewBox="0 0 16 10" width="13" height="8" aria-hidden="true"><path d="M2 2l6 6 6-6" /></svg>
                </button>
              )}
            </p>
          )}
        </div>
      )
    }
  </div>
  {
    reference && (
      <div class="panel" id={`${id}-reference`} hidden>
        <p class="reference">{authors.map((name, i) => <>{between(i)}{keepTogether(name)}</>)}{authorsEnd} ({year}). {title}{titleEnd} <Fragment set:html={reference} /></p>
        <Copy label="Copy" />
      </div>
    )
  }
  {
    bib && (
      <div class="panel" id={`${id}-bibtex`} hidden>
        <code class="bibtex" style={`--indent: ${bib.indent}`}>{bib.lines.map((line) => <span class:list={{ unbroken: /= \{\S+\},$/.test(line) }}>{line}</span>)}</code>
        <Copy label="Copy BibTeX" />
      </div>
    )
  }
</article>

<style>
  article {
    display: grid;
    grid-template-rows: auto 1fr;
    grid-area: 1 / 1;
    min-width: 0;
    color: var(--black);
  }

  article:not(.current) > :not(.picture) {
    visibility: hidden;
  }

  .picture {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
    transition: opacity 0.5s ease-in-out;
  }

  article:not(.current) .picture {
    opacity: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }

  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 14px;
  }

  h2 {
    margin-top: 18px;
    font: var(--heading);
  }

  .authors,
  .venue {
    font-size: 16px;
    line-height: 25px;
  }

  .authors {
    margin-top: 10px;
  }

  .venue {
    margin: 4px 0 14px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 20px;
    min-height: 56px;
    margin-top: auto;
    border-top: 1px solid var(--line);
  }

  .actions p {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
  }

  .actions a,
  .actions button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    font-weight: 700;
  }

  .actions a {
    gap: 10px;
  }

  .actions span {
    border-bottom: 2px solid var(--blue);
  }

  .actions button {
    gap: 9px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }

  .actions a:hover,
  .actions button:hover {
    color: var(--blue);
  }

  svg {
    flex: none;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  button svg {
    transition: transform 0.2s ease;
  }

  [aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .panel {
    padding: 14px 14px 0;
    border-top: 1px solid var(--line);
  }

  .reference {
    font: var(--text);
    overflow-wrap: anywhere;
  }

  .bibtex {
    display: block;
    margin: -14px -14px 0;
    padding: 16px 14px;
    background: var(--band);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 21px;
  }

  .bibtex span {
    display: block;
    padding-left: calc(var(--indent) * 1ch);
    text-indent: calc(var(--indent) * -1ch);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .bibtex .unbroken {
    word-break: break-all;
  }

  @media (min-width: 1024px) {
    article {
      grid-template-columns: minmax(0, 640fr) minmax(0, 610fr);
      grid-template-rows: 1fr;
    }

    .picture {
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .text {
      padding: 0 36px;
    }

    h2 {
      margin-top: 28px;
    }

    .authors {
      margin-top: 12px;
    }

    .actions,
    .actions p {
      column-gap: 28px;
    }

    .panel {
      grid-column: 1 / -1;
      padding: 18px 36px 0;
    }

    .reference {
      max-width: 940px;
    }

    .bibtex {
      margin: 4px 0 0;
      padding: 18px 20px;
      font-size: 14px;
      line-height: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .picture,
    button svg {
      transition: none;
    }
  }
</style>
