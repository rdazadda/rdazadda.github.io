---
import { SCALES } from '../data/bifactor-scales.js';
import { START, analyze, bias, narrate, passes } from '../lib/bifactor.js';
import { formatEffect } from '../lib/narration.js';

const bounded = (x) => formatEffect(x).replace('0.', '.');
const two = (x) => x.toFixed(2);
const width = (x) => `${(100 * x).toFixed(2)}%`;
const counts = ['None', 'One', 'Two', 'Three', 'Four', 'Five'];
const tabs = [
  ['items', 'Items'],
  ['total', 'Total score'],
  ['subscales', 'Subscales'],
  ['one', 'One factor?'],
  ['scores', 'Factor scores'],
];
const sides = ['general', 'group'];
const steps = [0, 0.5, 1];
const views = SCALES.map((scale) => {
  const result = analyze(scale.items);
  const passing = result.factors.filter(passes).length;
  return {
    ...scale,
    result,
    drift: bias(scale.items),
    names: { G: scale.general, ...Object.fromEntries(scale.subscales.map(({ key, name }) => [key, name])) },
    groupsSquared: Object.values(result.ecv.groups).reduce((a, b) => a + b, 0),
    blocks: scale.subscales.map(({ key, name }) => ({
      key,
      name,
      rows: scale.items.map((item, index) => ({ ...item, index })).filter((item) => item.subscale === key),
    })),
    totalVerdict: result.total.omegaH >= 0.8 ? `Reliable, and mostly ${scale.general.toLowerCase()}` : 'Reliable, but not a clean measure of one trait',
    oneVerdict: result.ecv.value >= 0.7 && result.puc.value >= 0.7 ? 'Close enough to one factor' : 'Too far from one factor',
    scoresVerdict: `${counts[passing]} of the ${counts[result.factors.length].toLowerCase()} factors ${passing === 1 ? 'passes' : 'pass'}`,
  };
});
---

<div class="bifactor">
  <p class="narration" aria-live="polite" set:html={narrate(views[0], views[0].result, views[0].drift, { tab: START.tab, item: START.item[views[0].key], subscale: START.subscale })} />

  <div class="scales" role="group" aria-label="Scale">
    <span class="scales-label">Scale</span>
    {
      views.map((view, i) => (
        <button type="button" data-scale={view.key} data-text={view.name} aria-pressed={String(i === 0)}>
          {view.name}
        </button>
      ))
    }
  </div>

  <div class="tabs" role="group" aria-label="Question">
    {
      tabs.map(([id, label], i) => (
        <button type="button" data-tab={id} data-text={label} aria-pressed={String(i === 0)}>
          {label}
        </button>
      ))
    }
  </div>

  <p class="hint">Pick an item in the table.</p>

  {
    views.map((view, v) => (
      <div class="stage" data-view={view.key} data-drift={view.drift} hidden={v > 0}>
        <div class="table" role="group" aria-label={`Loadings of the ${view.items.length} ${view.short} items on the general factor and on their own group factor`}>
          <div class="top" aria-hidden="true">
            <span class="title general">General loading</span>
            <span class="title group">Group loading</span>
            {sides.map((side) => steps.map((at) => <span class={`tick ${side}`} style={`--at: ${at}`}>{at === 0 ? '0' : at === 1 ? '1' : '.5'}</span>))}
          </div>

          {view.blocks.map((block) => (
            <div class="block">
              <p class="block-name">
                <b>{block.name}</b> <span>{block.rows.length} items</span>
              </p>
              <div class="rows">
                <div class="lines" aria-hidden="true">
                  {sides.map((side) => steps.map((at) => <span class={`line ${side}${at === 0 ? ' zero' : ''}`} style={`--at: ${at}`} />))}
                </div>
                {block.rows.map((item) => (
                  <button
                    type="button"
                    class="row"
                    data-item={item.index}
                    aria-pressed="false"
                    aria-label={`${item.label}, general ${bounded(item.general)}, group ${bounded(item.group)}`}
                  >
                    <span class="label">{item.label}</span>
                    <span class="track general">
                      <span class="bar" style={`width: ${width(item.general)}`} />
                    </span>
                    <span class="track group">
                      <span class={`bar${item.group < 0 ? ' negative' : ''}`} style={`width: ${width(Math.abs(item.group))}`} />
                    </span>
                  </button>
                ))}
              </div>
              <p class="foot">
                <span class="foot-label" />
                <span class="foot-general" />
                <span class="foot-group" />
              </p>
            </div>
          ))}

          <p class="foot grand">
            <span class="foot-label" />
            <span class="foot-general" />
            <span class="foot-group" />
          </p>
        </div>

        <div class="readout">
          <div class="panel" data-panel="items">
            <div>
              <p class="name item-name"></p>
              <p class="where"></p>
            </div>
            <div>
              <div class="common" aria-hidden="true">
                <span>Common</span>
                <span class="bracket"></span>
              </div>
              <div class="bar-box">
                <span class="part general item-general"></span>
                <span class="part group item-group"></span>
              </div>
            </div>
            <div class="ledger three">
              <div class="labels"><span>Source</span><span>Loading</span><span>Variance</span></div>
              <div><b class="general-text">General</b><span class="item-g"></span><b class="item-g2"></b></div>
              <div><b class="group-text item-subscale"></b><span class="item-s"></span><b class="item-s2"></b></div>
              <div><b>Unique</b><span></span><b class="item-u"></b></div>
            </div>
            <div class="big">
              <div>
                <p><b>I-ECV</b></p>
                <p>General share of the common variance</p>
              </div>
              <p class="big-number item-iecv"></p>
            </div>
          </div>

          <div class="panel" data-panel="total" hidden>
            <p class="name">Total score, {view.items.length} items</p>
            <div>
              <div class="marks" aria-hidden="true"><span class="mark" style="--at: 0.8">ω<sub>H</sub> .80</span></div>
              <div class="bar-box">
                <span class="part general" style={`width: ${width(view.result.total.omegaH)}`}></span>
                <span class="part group" style={`left: ${width(view.result.total.omegaH)}; width: ${width(view.result.total.group / view.result.total.variance)}`}></span>
              </div>
            </div>
            <div class="ledger two">
              <div><b class="general-text">General</b><span>{two(view.result.total.general)}</span></div>
              <div><b class="group-text">Groups</b><span>{two(view.result.total.group)}</span></div>
              <div><b>Unique</b><span>{two(view.result.total.unique)}</span></div>
              <div><span>Total-score variance</span><b>{two(view.result.total.variance)}</b></div>
            </div>
            <div class="ledger index">
              <div><b>ω</b><span>General and groups, over the total</span><b class="value">{bounded(view.result.total.omega)}</b></div>
              <div><b>ω<sub>H</sub></b><span>General only, over the total</span><b class="value">{bounded(view.result.total.omegaH)}</b></div>
              <div><b>ω<sub>H</sub> / ω</b><span>General part of the reliable variance</span><b class="value">{bounded(view.result.total.omegaH / view.result.total.omega)}</b></div>
              <div><b>α</b><span>Cannot split general from group</span><b class="value">{bounded(view.result.total.alpha)}</b></div>
            </div>
            <p class="verdict">{view.totalVerdict}</p>
          </div>

          <div class="panel" data-panel="subscales" hidden>
            <div>
              <div class="choice-head">
                <span>Subscale score variance</span>
                <span class="marks" aria-hidden="true"><span class="mark" style="--at: 0.5">ω<sub>HS</sub> .50</span></span>
              </div>
              {view.result.subscales.map((sub, k) => (
                <button type="button" class="choice" data-subscale={k} aria-pressed={String(k === 0)}>
                  <span class="choice-name">{view.names[sub.key]}</span>
                  <span class="choice-bar">
                    <span class="bar-box">
                      <span class="part group" style={`width: ${width(sub.omegaHS)}`} />
                      <span class="part general" style={`left: ${width(sub.omegaHS)}; width: ${width(sub.general / sub.variance)}`} />
                    </span>
                    <span class="cut" />
                  </span>
                </button>
              ))}
            </div>
            <div>
              <p class="name sub-title"></p>
              <div class="ledger two">
                <div><b class="group-text sub-name"></b><span class="sub-s"></span></div>
                <div><b class="general-text">General</b><span class="sub-g"></span></div>
                <div><b>Unique</b><span class="sub-u"></span></div>
                <div><span>Subscale score variance</span><b class="sub-v"></b></div>
              </div>
            </div>
            <div class="ledger index">
              <div><b>ω</b><span>Group and general, over the subscale score</span><b class="value sub-omega"></b></div>
              <div><b>ω<sub>HS</sub></b><span>Group only, over the subscale score</span><b class="value sub-hs"></b></div>
            </div>
            <p class="verdict sub-verdict"></p>
          </div>

          <div class="panel" data-panel="one" hidden>
            <div>
              <div class="big">
                <div>
                  <p><b>ECV</b></p>
                  <p>General share of all common variance</p>
                </div>
                <p class="big-number">{bounded(view.result.ecv.value)}</p>
              </div>
              <div class="marks" aria-hidden="true"><span class="mark" style="--at: 0.7">ECV .70</span></div>
              <div class="bar-box whole">
                <span class="part general" style={`width: ${width(view.result.ecv.value)}`}></span>
              </div>
              <p class="ends">
                <b class="general-text">General {two(view.result.ecv.general)}</b>
                <b class="group-text">Groups {two(view.groupsSquared)}</b>
              </p>
            </div>
            <div>
              <div class="big">
                <div>
                  <p><b>PUC</b></p>
                  <p>Share of the {view.result.puc.pairs} item pairs from different subscales</p>
                </div>
                <p class="big-number">{bounded(view.result.puc.value)}</p>
              </div>
              <div class="marks" aria-hidden="true"><span class="mark" style="--at: 0.7">PUC .70</span></div>
              <div class="bar-box whole">
                <span class="part general" style={`width: ${width(view.result.puc.value)}`}></span>
              </div>
              <p class="ends">
                <b class="general-text">{view.result.puc.between} across subscales, general only</b>
                <b class="group-text">{view.result.puc.within} within, general and group</b>
              </p>
            </div>
            <div class="big ruled">
              <div>
                <p><b>Mean relative bias</b></p>
                <p>One-factor loadings against the general loadings</p>
              </div>
              <p class="bias">{Math.round(100 * view.drift)}%</p>
            </div>
            <p class="verdict">{view.oneVerdict}</p>
          </div>

          <div class="panel" data-panel="scores" hidden>
            <div class="scores">
              <div class="score-head">
                <span></span>
                <b>Determinacy (FD)</b>
                <b>Replicability (H)</b>
              </div>
              <div class="score-marks" aria-hidden="true">
                <span></span>
                <span><span class="scale"><span class="mark" style="--at: 0.9">.90</span></span></span>
                <span><span class="scale"><span class="mark" style="--at: 0.7">.70</span></span></span>
              </div>
              {view.result.factors.map((f) => (
                <div class="score">
                  <div class="factor">
                    <p>{view.names[f.key]}</p>
                    <p class={passes(f) ? 'pass' : ''}>{passes(f) ? 'Passes' : 'Falls short'}</p>
                  </div>
                  {[
                    [f.fd, 0.9],
                    [f.h, 0.7],
                  ].map(([value, cut]) => (
                    <div class="dot-cell">
                      <b>{bounded(value)}</b>
                      <span class="scale">
                        <span class="cut" style={`--at: ${cut}`} />
                        <span class={`dot ${f.key === 'G' ? 'general' : 'group'}`} style={`--at: ${value.toFixed(4)}`} />
                      </span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
            <p class="verdict">{view.scoresVerdict}</p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .bifactor {
    --deep: #143d5e;
    --gold: #c99400;
    --gold-text: #7d5c00;
    --ink: #30394f;
    --rule: #d3dae2;
    --empty: #dde3ea;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    max-width: 1240px;
  }

  p {
    margin: 0;
  }

  .narration {
    max-width: var(--measure);
    min-height: calc(3 * 1.35em);
  }

  sub {
    line-height: 0;
  }

  .scales {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 28px;
  }

  .scales-label {
    color: var(--c-muted);
    font-size: 0.875rem;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
    border-bottom: 1px solid var(--rule);
  }

  .scales button,
  .tabs button {
    min-height: 44px;
    margin-bottom: -1px;
    padding: 0;
    border: 0;
    border-bottom: 3px solid transparent;
    background: none;
    color: var(--c-text);
    font: inherit;
    font-size: 1.0625rem;
    cursor: pointer;
  }

  .scales button::after,
  .tabs button::after {
    content: attr(data-text);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 700;
  }

  .scales button:hover,
  .tabs button:hover {
    color: var(--c-link);
  }

  .scales button[aria-pressed='true'],
  .tabs button[aria-pressed='true'] {
    border-bottom-color: var(--deep);
    color: var(--deep);
    font-weight: 700;
    cursor: default;
  }

  .scales button:focus-visible,
  .tabs button:focus-visible,
  .row:focus-visible,
  .choice:focus-visible {
    outline: 2px solid var(--c-link);
    outline-offset: 2px;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 640fr) minmax(0, 544fr);
    gap: 0 56px;
    align-items: start;
    padding-top: 4px;
  }

  .stage[hidden] {
    display: none;
  }

  .table {
    --lab: 21.5%;
    --gz: 23.5%;
    --kz: 66%;
    --sc: 32.8%;
    --pitch: 16px;
    --bar: 10px;
    min-width: 0;
  }

  .general {
    --zero: var(--gz);
  }

  .group {
    --zero: var(--kz);
  }

  .top {
    position: relative;
    height: 46px;
  }

  .title {
    position: absolute;
    top: 0;
    left: var(--zero);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 20px;
    white-space: nowrap;
  }

  .title.general,
  .foot-general,
  .general-text {
    color: var(--c-brand);
  }

  .title.group,
  .foot-group,
  .group-text {
    color: var(--gold-text);
  }

  .tick {
    position: absolute;
    top: 24px;
    left: calc(var(--zero) + var(--at) * var(--sc));
    color: var(--c-muted);
    font-size: 0.8125rem;
    line-height: 16px;
    transform: translateX(-50%);
  }

  .block-name {
    line-height: 20px;
    margin-bottom: 6px;
    white-space: nowrap;
  }

  .block-name b {
    font-size: 0.9375rem;
  }

  .block-name span {
    margin-left: 4px;
    color: var(--c-muted);
    font-size: 0.875rem;
  }

  .rows {
    position: relative;
  }

  .lines {
    position: absolute;
    inset: 0;
  }

  .line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--zero) + var(--at) * var(--sc));
    width: 1px;
    background: #e3e7ec;
  }

  .line.zero {
    background: var(--ink);
  }

  .row {
    position: relative;
    display: block;
    width: 100%;
    height: var(--pitch);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: none;
    color: var(--c-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .row:disabled {
    cursor: default;
  }

  .row[aria-pressed='true'] {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  .label {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--lab);
    font-size: 0.875rem;
    line-height: var(--pitch);
    text-align: right;
    white-space: nowrap;
  }

  .row[aria-pressed='true'] .label {
    font-weight: 700;
  }

  .track {
    position: absolute;
    top: calc((var(--pitch) - var(--bar)) / 2);
    left: var(--zero);
    width: var(--sc);
    height: var(--bar);
  }

  .bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    transition: width 0.35s ease;
  }

  .general .bar {
    background: var(--c-brand);
  }

  .group .bar {
    background: var(--gold);
  }

  .bar.negative {
    right: 100%;
    left: auto;
  }

  .row.dim .bar,
  .bar.faint {
    opacity: 0.22;
  }

  .foot {
    position: relative;
    height: 20px;
    margin: 4px 0 18px;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 20px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .foot-label {
    position: absolute;
    left: 0;
    width: var(--lab);
    color: var(--c-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    text-align: right;
  }

  .foot-general,
  .foot-group {
    position: absolute;
  }

  .foot-general {
    left: var(--gz);
  }

  .foot-group {
    left: var(--kz);
  }

  .grand {
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
  }

  .grand.blank {
    border-top-color: transparent;
  }

  .readout {
    min-width: 0;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .panel[hidden] {
    display: none;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .item-name {
    font-size: 1.5rem;
  }

  .sub-title {
    margin-bottom: 8px;
  }

  .where {
    margin-top: 4px;
  }

  .common {
    position: relative;
    height: 26px;
  }

  .common span:first-child {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--c-muted);
    font-size: 0.875rem;
    line-height: 16px;
  }

  .bracket {
    position: absolute;
    bottom: 0;
    left: 0;
    box-sizing: border-box;
    height: 8px;
    border: 1px solid var(--ink);
    border-bottom: 0;
  }

  .bar-box {
    position: relative;
    display: block;
    height: 30px;
    margin-top: 2px;
    background: var(--empty);
  }

  .bar-box.whole {
    margin-top: 0;
    background: var(--gold);
  }

  .part {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  .part.general {
    background: var(--c-brand);
  }

  .part.group {
    background: var(--gold);
  }

  .ledger {
    border-top: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }

  .ledger > div {
    display: grid;
    align-items: baseline;
    column-gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--rule);
  }

  .ledger.two > div {
    grid-template-columns: minmax(0, 1fr) 100px;
  }

  .ledger.three > div {
    grid-template-columns: minmax(0, 1fr) 88px 88px;
  }

  .ledger.index > div {
    grid-template-columns: 72px minmax(0, 1fr) 56px;
  }

  .ledger.two > div > :last-child,
  .ledger.three > div > :not(:first-child),
  .ledger .value {
    text-align: right;
  }

  .ledger.three {
    border-top: 0;
  }

  .ledger .labels {
    padding-top: 0;
    color: var(--c-muted);
    font-size: 0.875rem;
  }

  .ledger .value {
    font-size: 1.125rem;
  }

  .big {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .big p + p {
    margin-top: 2px;
  }

  .big-number {
    color: var(--deep);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .big.ruled {
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .bias {
    color: var(--deep);
    font-size: 1.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .verdict {
    color: var(--deep);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .marks {
    position: relative;
    display: block;
    height: 30px;
    margin-top: 6px;
  }

  .mark {
    position: absolute;
    top: 0;
    left: calc(var(--at) * 100%);
    color: var(--c-muted);
    font-size: 0.875rem;
    line-height: 18px;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .mark::after {
    content: '';
    position: absolute;
    top: 22px;
    left: 50%;
    height: 8px;
    border-left: 1px solid var(--ink);
  }

  .ends {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
  }

  .choice-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56%;
    column-gap: 12px;
    align-items: end;
    padding: 0 6px;
    color: var(--c-muted);
    font-size: 0.875rem;
  }

  .choice-head .marks {
    margin-top: 0;
  }

  .choice {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56%;
    column-gap: 12px;
    align-items: center;
    width: 100%;
