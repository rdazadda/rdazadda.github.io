---
const hours = [
  { label: 'midnight', at: 0 },
  { label: '6 am', at: 25 },
  { label: 'noon', at: 50 },
  { label: '6 pm', at: 75 },
  { label: 'midnight', at: 100 },
];
---

<figure
  class="day-strip"
  data-day-strip
  tabindex="0"
  aria-label="The sky over Fairbanks today. Use the left and right arrow keys to read each hour."
>
  <div class="sky">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"></svg>
    <div class="snow" aria-hidden="true"></div>
    <div class="now-icon" aria-hidden="true"></div>
  </div>
  <div class="tip" aria-hidden="true" hidden></div>
  <div class="hours" aria-hidden="true">
    {hours.map((hour) => <span style={`left: ${hour.at}%`}>{hour.label}</span>)}
  </div>
  <figcaption><span class="line"></span><span class="line"></span></figcaption>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</figure>

<style>
  .day-strip {
    position: relative;
    margin: 0.7em 0 0.8em;
    border-radius: 10px;
  }

  .day-strip:focus-visible {
    outline: 2px solid var(--c-link);
    outline-offset: 4px;
  }

  .sky {
    position: relative;
  }

  svg {
    display: block;
    width: 100%;
    height: 44px;
    border-radius: 8px;
    cursor: crosshair;
  }

  .snow {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 8px;
    pointer-events: none;
  }

  .snow :global(i) {
    position: absolute;
    top: -4px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: #ffffff;
    box-shadow: 0 0 0 1px rgb(19 51 79 / 0.35);
    animation: fall linear infinite;
  }

  @keyframes fall {
    to {
      transform: translate(6px, 52px);
    }
  }

  .now-icon {
    position: absolute;
    top: -8px;
    line-height: 0;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .tip {
    position: absolute;
    bottom: calc(100% + 0.2em);
    z-index: 1;
    padding: 0.3em 0.7em;
    border-radius: 6px;
    background-color: var(--c-text);
    color: var(--c-bg);
    font-size: 0.8rem;
    white-space: nowrap;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .hours {
    position: relative;
    height: 1.3em;
    color: var(--c-muted);
    font-size: 0.75rem;
  }

  .hours span {
    position: absolute;
    top: 2px;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .hours span:first-child {
    transform: none;
  }

  .hours span:last-child {
    transform: translateX(-100%);
  }

  figcaption {
    margin-top: 4px;
    color: var(--c-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  figcaption .line {
    display: block;
    min-height: 1.4em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  svg :global(.night) {
    fill: var(--strip-night);
  }

  svg :global(.day-stop) {
    stop-color: var(--strip-day);
  }

  svg :global(.aurora-stop) {
    stop-color: var(--strip-aurora);
  }

  svg :global(.moon-edge) {
    fill: var(--strip-night);
    fill-opacity: 0.5;
  }

  svg :global(.moon-up) {
    fill: #f4f7fb;
  }

  svg :global(.temp.forecast) {
    fill-opacity: 0.5;
  }

  svg :global(.now-edge) {
    fill: var(--strip-night);
  }

  svg :global(.now) {
    fill: var(--strip-now);
  }

  svg:global(.intro) {
    animation: fade-in 1.2s ease both;
  }

  svg :global(.grow) {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: grow 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 8ms);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg:global(.intro),
    svg :global(.grow) {
      animation: none;
    }

    .snow :global(i) {
      top: var(--rest);
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/day-strip.js';
</script>
