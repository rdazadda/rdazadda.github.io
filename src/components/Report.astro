---
import Copy from './Copy.astro';

interface Props {
  lead: string;
  text: string;
}

const { lead, text } = Astro.props;
---

<p class="lead" set:html={lead} />
<p class="template" id="report-text" set:html={text} />
<Copy label="Copy" />

<style>
  .lead {
    font-size: 17px;
    line-height: 28px;
  }

  .template {
    margin: 16px calc(var(--pad) * -1) 0;
    padding: 18px var(--pad);
    background: var(--band);
    color: var(--black);
    font-size: 16px;
    line-height: 26px;
  }

  @media (min-width: 1024px) {
    .lead {
      margin-top: 14px;
      font-size: 18px;
      line-height: 29px;
    }

    .template {
      margin: 18px 0 0;
      padding: 20px 22px;
      font-size: 17px;
      line-height: 28px;
    }
  }
</style>
