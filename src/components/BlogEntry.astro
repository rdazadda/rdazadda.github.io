---
interface Props {
  kind: string;
  year: string;
  title: string;
  about: string;
  link: string;
  image?: string;
  video?: string;
}

const { kind, year, title, about, link, image, video } = Astro.props;
---

<li data-kind={kind} data-year={year}>
  <div class="lead">
    <a href={link} class="frame" aria-hidden="true" tabindex="-1">
      <span class="print">
        {video ? (
          <video src={video} poster={image} width="200" height="200" muted loop playsinline preload="none" data-clip />
        ) : image ? (
          <img src={image} alt="" width="200" height="200" loading="lazy" />
        ) : (
          <span class="blank" />
        )}
      </span>
    </a>
  </div>
  <div class="text">
    <p class="title"><span class="label">Title:</span> <a href={link}>{title}</a></p>
    <p><span class="label">What it covers:</span> <Fragment set:html={about} /></p>
    <p class="actions">
      <a href={link}>
        <span>Read the post</span>
      </a>
    </p>
  </div>
</li>

<style>
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px 36px;
    margin: 0;
  }

  li:not([hidden]) {
    counter-increment: entry;
  }

  li[hidden] {
    display: none;
  }

  .lead {
    display: flex;
    flex: none;
    align-items: flex-start;
    gap: 14px;
  }

  .lead::before {
    flex: 0 0 36px;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
    content: counter(entry) '.';
  }

  .frame {
    display: block;
    box-sizing: border-box;
    width: 240px;
    padding: 10px;
    border: var(--line) solid var(--c-brand);
    background-color: var(--c-card);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.1),
      0 16px 30px -12px rgb(0 0 0 / 0.38);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  li:has(a:hover) .frame,
  li:has(a:focus-visible) .frame {
    border-color: var(--c-frame-hover);
    box-shadow:
      0 0 0 calc(var(--line) * 2) var(--c-frame-hover),
      0 22px 38px -14px rgb(0 0 0 / 0.42);
  }

  .print {
    display: block;
  }

  .print img,
  .print video,
  .blank {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
  }

  .print img,
  .print video {
    object-fit: cover;
  }

  .blank {
    background-color: #ffffff;
  }

  .text {
    display: flex;
    flex: 999 1 420px;
    flex-direction: column;
    min-width: 0;
    max-width: var(--measure);
  }

  .text p {
    margin: 0;
  }

  .title {
    font-weight: 700;
    text-wrap: pretty;
  }

  .title a:link,
  .title a:visited {
    color: var(--c-text);
  }

  .title a:hover {
    text-decoration: none;
  }

  .label {
    color: var(--c-muted);
    font-weight: 400;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14px;
    margin-left: -4px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .actions span {
    padding: 0 4px;
  }

  .actions a:hover {
    text-decoration: none;
  }

  .actions a:hover span {
    background-color: var(--c-link);
    color: var(--c-bg);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame {
      transition: none;
    }
  }
</style>
