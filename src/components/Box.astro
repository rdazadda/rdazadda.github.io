---
interface Slide {
  image: string;
  video?: string;
  alt?: string;
  caption: string | string[];
}

interface Props {
  title: string;
  link: string;
  slides: Slide[];
}

const { title, link, slides } = Astro.props;
const rotates = slides.length > 1;
---

<div class="stackpreview">
  <div class:list={['slides', { rotate: rotates }]} data-rotate={rotates ? '' : undefined}>
    {
      slides.map((slide, i) => (
        <div class={rotates && i === 0 ? 'current' : undefined} inert={i > 0 ? true : undefined}>
          <p class="mat">
            <a href={link} class="print">
              {slide.video ? (
                <video width="300" height="300" src={slide.video} poster={slide.image} muted playsinline preload="auto" loop={!rotates} aria-label={slide.alt ?? title} />
              ) : (
                <img width="300" height="300" src={slide.image} alt={slide.alt ?? title} />
              )}
            </a>
          </p>
          <div class="label">
            <p class="heading">
              <a href={link}>{title}</a>
            </p>
            {[slide.caption].flat().map((text) => (
              <p class="caption" set:html={text} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stackpreview {
    display: inline-block;
    width: 320px;
    margin: 3ex 1em;
    border: var(--line) solid var(--c-brand);
    background-color: var(--c-mat);
    vertical-align: top;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .stackpreview:hover,
  .stackpreview:has(:focus-visible) {
    border-color: var(--c-frame-hover);
    box-shadow: 0 0 0 var(--line) var(--c-frame-hover);
  }

  .slides {
    display: grid;
  }

  .slides > * {
    grid-area: 1 / 1;
  }

  .rotate > * {
    transition: opacity 0.9s ease-in-out;
  }

  .rotate > :not(.current) {
    opacity: 0;
  }

  :where(.stackpreview p) {
    margin: 0;
  }

  .mat {
    padding: 12px;
  }

  .print {
    display: block;
    padding: 7px;
    background-color: #ffffff;
    box-shadow: var(--shadow-print);
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }

  .stackpreview:hover .print {
    box-shadow: var(--shadow-print-lifted);
    transform: translateY(-2px);
  }

  .print img,
  .print video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .label {
    padding: 0 16px 16px;
    text-align: center;
  }

  .heading {
    line-height: 1.25;
    text-wrap: balance;
  }

  .heading a:hover {
    background-color: var(--c-link);
    color: var(--c-bg);
    text-decoration: none;
  }

  .caption {
    margin-top: 6px;
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .stackpreview,
    .rotate > *,
    .print {
      transition: none;
    }

    .stackpreview:hover .print {
      transform: none;
    }
  }
</style>

<script>
  import '../scripts/unify-boxes.js';
  import '../scripts/rotate.js';
</script>
