---
import Band from './Band.astro';
import More from './More.astro';

interface Props {
  home: { label: string; href: string };
  first: boolean;
  title: string;
  subtitle?: string;
  facts: { label: string; value: string }[];
  lead: string;
  images?: string[];
  links?: { label: string; href: string }[];
  more: string;
  others: { href: string; image?: string; title: string; note: string }[];
  turn?: string;
  current?: boolean;
}

const { home, first, title, subtitle, facts, lead, images = [], links = [], more, others, turn, current } = Astro.props;
const where = first ? { label: home.label } : { label: `Back to ${home.label}`, href: home.href };
const turns = images.length > 1;
const waits = (i) => (i > 0 || (turn && !current) ? 'lazy' : undefined);

const whole = (image) => image.endsWith('.png');
const download = (href) => /\.(exe|msi|dmg|pkg|appimage|deb|rpm|zip)$/i.test(href);
---

<article class:list={{ current: turn && current }} data-turn={turn}>
  <Band where={where} title={title} subtitle={subtitle} facts={facts} />

  <div class="body">
    <div class="main">
      <p class="lead" set:html={lead} />
      {images.length > 0 && (
        <div class:list={['pictures', { turning: turns }]} data-rotate={turns ? '' : undefined}>
          {images.map((image, i) =>
            whole(image) ? (
              <span class:list={['panel', { current: turns && i === 0 }]}>
                <img src={image} alt="" width="593" height="444" loading={waits(i)} />
              </span>
            ) : (
              <img class:list={['photo', { current: turns && i === 0 }]} src={image} alt="" width="790" height="444" loading={waits(i)} />
            ),
          )}
        </div>
      )}
      {turns && (
        <div class="dots" role="group" aria-label="Pictures" data-dots>
          {images.map((image, i) => (
            <button type="button" aria-label={`Picture ${i + 1} of ${images.length}`} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span />
            </button>
          ))}
        </div>
      )}
      <slot />
    </div>

    <aside>
      {links.length > 0 && (
        <section class="links">
          <h2>Links</h2>
          {links.map((link) => (
            <a href={link.href}>
              {link.label}
              {download(link.href) ? (
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v9.7M5.7 8.4 10 12.7l4.3-4.3M3.5 17h13" /></svg>
              ) : (
                <svg viewBox="0 0 10 16" width="8" height="13" aria-hidden="true"><path d="M2 2l6 6-6 6" /></svg>
              )}
            </a>
          ))}
        </section>
      )}
      <section>
        <h2>{more}</h2>
        <More others={others} />
      </section>
    </aside>
  </div>
</article>

<style>
  svg {
    flex: none;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .body {
    display: grid;
    gap: 42px;
    padding: 30px var(--pad) 50px;
  }

  .main,
  aside {
    min-width: 0;
  }

  .lead {
    color: var(--black);
    font: var(--lead);
  }

  .pictures {
    display: grid;
    margin: 26px calc(var(--pad) * -1) 0;
    overflow: hidden;
  }

  .pictures > * {
    grid-area: 1 / 1;
  }

  .turning > * {
    transition: opacity 0.9s ease-in-out;
  }

  .turning > :not(.current) {
    opacity: 0;
  }

  .panel {
    display: flex;
    justify-content: center;
    background: var(--band);
    isolation: isolate;
  }

  .panel img {
    display: block;
    width: 75%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .dots {
    display: flex;
    justify-content: center;
    margin: 2px 0 -22px;
  }

  .dots button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
    transition: background-color 0.9s ease-in-out;
  }

  .dots [aria-pressed='true'] span {
    background: var(--blue);
  }

  aside {
    display: grid;
    align-content: start;
    gap: 42px;
  }

  h2 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
    color: var(--black);
    font: var(--side);
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 54px;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    font-weight: 700;
    line-height: 22px;
  }

  .links a:hover {
    color: var(--blue);
  }

  @media (min-width: 1024px) {
    .body {
      grid-template-columns: minmax(0, 79fr) minmax(0, 40fr);
      gap: clamp(32px, 4.8%, 60px);
      padding-top: 48px;
      padding-bottom: 72px;
    }

    .pictures {
      margin: 30px 0 0;
    }

    aside {
      gap: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turning > *,
    .dots span {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/rotate.js';
</script>
